<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="15sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <Button
            android:id="@+id/btnEnableService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="开启无障碍服务" />

        <Button
            android:id="@+id/btnEnableOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="开启悬浮窗权限" />

        <!-- 执行模式区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/section_border">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="执行模式"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/radioClick"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="点击"
                    android:background="@drawable/btn_selector_bg"
                    android:textColor="#FFFFFFFF"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/radioSwipe"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="滑动"
                    android:background="@drawable/btn_selector_bg"
                    android:textColor="#FFFFFFFF"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- 滑动参数区域 -->
        <LinearLayout
            android:id="@+id/swipeParams"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 滑动方式 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:background="@drawable/section_border">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="滑动方式"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/radioSwipeManual"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="手动参数"
                        android:background="@drawable/btn_selector_bg"
                        android:textColor="#FFFFFFFF"
                        android:stateListAnimator="@null" />

                    <Button
                        android:id="@+id/radioSwipeGesture"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="手势录制"
                        android:background="@drawable/btn_selector_bg"
                        android:textColor="#FFFFFFFF"
                        android:stateListAnimator="@null" />
                </LinearLayout>
            </LinearLayout>

            <!-- 手动参数 -->
            <LinearLayout
                android:id="@+id/manualSwipeParams"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:background="@drawable/section_border">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="起点"
                    android:textSize="13sp"
                    android:textColor="@color/md_theme_primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/inputSwipeX1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:hint="起点 X (横向坐标)"
                        android:inputType="numberDecimal" />

                    <EditText
                        android:id="@+id/inputSwipeY1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:hint="起点 Y (纵向坐标)"
                        android:inputType="numberDecimal" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="终点"
                    android:textSize="13sp"
                    android:textColor="@color/md_theme_primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/inputSwipeX2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:hint="终点 X (横向坐标)"
                        android:inputType="numberDecimal" />

                    <EditText
                        android:id="@+id/inputSwipeY2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:hint="终点 Y (纵向坐标)"
                        android:inputType="numberDecimal" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="时长"
                    android:textSize="13sp"
                    android:textColor="@color/md_theme_primary" />

                <EditText
                    android:id="@+id/inputSwipeDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="滑动耗时(毫秒)"
                    android:inputType="number" />
            </LinearLayout>

            <!-- 手势录制 -->
            <LinearLayout
                android:id="@+id/gestureSwipeSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="12dp"
                android:background="@drawable/section_border">

                <TextView
                    android:id="@+id/lblRecordedStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="@color/md_theme_primary" />

                <Button
                    android:id="@+id/btnRecordGesture"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="录制手势 (在屏幕上滑动)" />
            </LinearLayout>
        </LinearLayout>

        <!-- 执行前延时 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/section_border">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="执行前延时(毫秒)"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inputDelay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="延时毫秒数"
                android:inputType="number"
                android:text="0" />
        </LinearLayout>

        <!-- 重复次数 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/section_border">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="重复次数"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/inputRepeat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="次数"
                    android:inputType="number"
                    android:text="1" />

                <Switch
                    android:id="@+id/checkInfinite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="无限循环"
                    android:textOn="开"
                    android:textOff="关" />
            </LinearLayout>
        </LinearLayout>

        <!-- 操作按钮 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/btnStartFloating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启动悬浮球"
                android:enabled="false" />

            <View
                android:id="@+id/btnStartOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:visibility="gone" />
        </FrameLayout>

        <Button
            android:id="@+id/btnStopFloating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="停止悬浮球"
            android:enabled="false" />

    </LinearLayout>
</ScrollView>
