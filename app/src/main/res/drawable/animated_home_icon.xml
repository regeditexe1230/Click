<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 选中状态：填充图标 -->
    <item
        android:id="@+id/state_selected"
        android:drawable="@drawable/ic_home"
        android:state_selected="true" />
    <!-- 未选中状态：线稿图标 -->
    <item
        android:id="@+id/state_unselected"
        android:drawable="@drawable/ic_home_outline" />

    <!-- 从未选中到选中：填充动画 -->
    <transition
        android:fromId="@id/state_unselected"
        android:toId="@id/state_selected"
        android:drawable="@drawable/avd_home_to_filled" />
    <!-- 从选中到未选中：消失动画 -->
    <transition
        android:fromId="@id/state_selected"
        android:toId="@id/state_unselected"
        android:drawable="@drawable/avd_home_to_outline" />
</animated-selector>
