<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮球（动态取色版）：圆底走主题 colorPrimary，套了 Material You overlay 的 context 解析出来
     就是壁纸派生的主色；固定配色下用 ic_floating_icon（@color/purple_500，和旧版一致）。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="60dp"
    android:height="60dp"
    android:viewportWidth="60"
    android:viewportHeight="60">
    <path
        android:fillColor="?attr/colorPrimary"
        android:pathData="M30,2A28,28 0 1,0 30,58A28,28 0 1,0 30,2Z" />
    <path
        android:strokeWidth="4"
        android:strokeColor="#FFFFFF"
        android:pathData="M20,30 L40,30 M30,20 L30,40" />
</vector>
