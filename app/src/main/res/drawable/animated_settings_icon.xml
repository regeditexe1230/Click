<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/state_selected"
        android:drawable="@drawable/animated_settings"
        android:state_selected="true" />
    <item
        android:id="@+id/state_unselected"
        android:drawable="@drawable/ic_settings_new" />

    <transition
        android:fromId="@id/state_unselected"
        android:toId="@id/state_selected"
        android:drawable="@drawable/animated_settings" />
    <transition
        android:fromId="@id/state_selected"
        android:toId="@id/state_unselected"
        android:drawable="@drawable/animated_settings_reverse" />
</animated-selector>
