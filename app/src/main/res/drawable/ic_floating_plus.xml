<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮球里的白色加号（圆底由 FloatingService 在运行时按配色画，见 applyFloatingIcon）。
     与原 ic_floating_icon 的加号完全一致：60 视口、strokeWidth 4、M20,30 L40,30 M30,20 L30,40。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="60dp"
    android:height="60dp"
    android:viewportWidth="60"
    android:viewportHeight="60">
    <path
        android:strokeWidth="4"
        android:strokeColor="#FFFFFF"
        android:pathData="M20,30 L40,30 M30,20 L30,40" />
</vector>
